+						auto *port = *reinterpret_cast<uint8_t **>(pp + 0x3648);
+						auto *pcfg = port ? *reinterpret_cast<uint8_t **>(port + 0x548) : nullptr;
+						if (!pcfg) continue;
+						uint32_t trans = *reinterpret_cast<uint32_t *>(pcfg + 0x8) == 0 ? 0xf : *reinterpret_cast<uint32_t *>(pp + 0x3640);
+						if (NGreen::callback->readReg32(0x60044 + (trans << 12)) == 0) continue;
 					}
 					IODetailedTimingInformationV2 t;
 					bzero(&t, sizeof(t));
