  * Bitmask of DRM_UT_x. See include/drm/drm_print.h for details.
  */
-#ifdef __linux__
+#if defined(NMXKPI) && defined(NMX_DRM_DEBUG)
+/*
+ * macOS port (NMXGPU), diagnostic build: there is no drm.debug boot parameter on macOS, so the categories are
