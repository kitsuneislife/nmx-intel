+#include <sys/types.h>
+#include <sys/systm.h>
+#include <sys/malloc.h>
+#include <sys/kernel.h>
+#include <sys/lock.h>
+#include <sys/mutex.h>
+#include <sys/proc.h>
+#include <sys/sched.h>
+#include <sys/smp.h>
+#include <sys/queue.h>
+#include <sys/taskqueue.h>
+#include <sys/kdb.h>
+
+#include <ck_epoch.h>
+
+#include <linux/rcupdate.h>
+#include <linux/sched.h>
+#include <linux/srcu.h>
+#include <linux/slab.h>
+#include <linux/kernel.h>
+#include <linux/compat.h>
+#include <linux/llist.h>
+#include <linux/irq_work.h>
+
+/*
+ * By defining CONFIG_NO_RCU_SKIP LinuxKPI RCU locks and asserts will
+ * not be skipped during panic().
+ */
+#ifdef CONFIG_NO_RCU_SKIP
+#define	RCU_SKIP(void) 0
+#else
+#define	RCU_SKIP(void)	unlikely(SCHEDULER_STOPPED() || kdb_active)
+#endif
+
+struct callback_head {
+	union {
+		STAILQ_ENTRY(callback_head) entry;
+		struct llist_node node;
+	};
+	rcu_callback_t func;
+};
+
+struct linux_epoch_head {
+	struct llist_head cb_head;
+	struct task task;
+} __aligned(CACHE_LINE_SIZE);
+
+struct linux_epoch_record {
+	ck_epoch_record_t epoch_record;
+	TAILQ_HEAD(, task_struct) ts_head;
+	int cpuid;
+	int type;
+} __aligned(CACHE_LINE_SIZE);
+
+/*
+ * Verify that "struct rcu_head" is big enough to hold "struct
+ * callback_head". This has been done to avoid having to add special
+ * compile flags for including ck_epoch.h to all clients of the
+ * LinuxKPI.
+ */
+CTASSERT(sizeof(struct rcu_head) == sizeof(struct callback_head));
+
+/*
+ * Verify that "rcu_section[0]" has the same size as
+ * "ck_epoch_section_t". This has been done to avoid having to add
+ * special compile flags for including ck_epoch.h to all clients of
+ * the LinuxKPI.
+ */
+CTASSERT(sizeof(((struct task_struct *)0)->rcu_section[0] ==
+    sizeof(ck_epoch_section_t)));
+
+/*
+ * Verify that "epoch_record" is at beginning of "struct
+ * linux_epoch_record":
+ */
+CTASSERT(offsetof(struct linux_epoch_record, epoch_record) == 0);
+
+CTASSERT(TS_RCU_TYPE_MAX == RCU_TYPE_MAX);
+
+static ck_epoch_t linux_epoch[RCU_TYPE_MAX];
+static struct linux_epoch_head linux_epoch_head[RCU_TYPE_MAX];
+DPCPU_DEFINE_STATIC(struct linux_epoch_record, linux_epoch_record[RCU_TYPE_MAX]);
+
+static void linux_rcu_cleaner_func(void *, int);
+
+static void
+linux_rcu_runtime_init(void *arg __unused)
+{
+	struct linux_epoch_head *head;
+	int i;
+	int j;
+
+	for (j = 0; j != RCU_TYPE_MAX; j++) {
+		ck_epoch_init(&linux_epoch[j]);
+
+		head = &linux_epoch_head[j];
+
+		TASK_INIT(&head->task, 0, linux_rcu_cleaner_func, head);
+		init_llist_head(&head->cb_head);
+
+		CPU_FOREACH(i) {
+			struct linux_epoch_record *record;
+
+			record = &DPCPU_ID_GET(i, linux_epoch_record[j]);
+
+			record->cpuid = i;
+			record->type = j;
+			ck_epoch_register(&linux_epoch[j],
+			    &record->epoch_record, NULL);
+			TAILQ_INIT(&record->ts_head);
+		}
+	}
+}
+SYSINIT(linux_rcu_runtime, SI_SUB_CPU, SI_ORDER_ANY, linux_rcu_runtime_init, NULL);
+
+static void
+linux_rcu_cleaner_func(void *context, int pending __unused)
+{
+	struct linux_epoch_head *head = context;
+	struct callback_head *rcu;
+	STAILQ_HEAD(, callback_head) tmp_head;
+	struct llist_node *node, *next;
+	uintptr_t offset;
+
+	/* move current callbacks into own queue */
+	STAILQ_INIT(&tmp_head);
+	llist_for_each_safe(node, next, llist_del_all(&head->cb_head)) {
+		rcu = container_of(node, struct callback_head, node);
+		/* re-reverse list to restore chronological order */
+		STAILQ_INSERT_HEAD(&tmp_head, rcu, entry);
+	}
+
+	/* synchronize */
+	linux_synchronize_rcu(head - linux_epoch_head);
+
+	/* dispatch all callbacks, if any */
+	while ((rcu = STAILQ_FIRST(&tmp_head)) != NULL) {
+		STAILQ_REMOVE_HEAD(&tmp_head, entry);
+
+		offset = (uintptr_t)rcu->func;
+
+		if (offset < LINUX_KFREE_RCU_OFFSET_MAX)
+			kfree((char *)rcu - offset);
+		else
+			rcu->func((struct rcu_head *)rcu);
+	}
+}
+
+/*
+ * NullMoth (nmx-intel 0021): RCU readers on xnu. FreeBSD pins a reader to its CPU and uses that CPU's epoch record;
+ * xnu does not let a kext pin a thread, so the port's sched_pin turns interrupts off, counted per CPU. A reader that
+ * blocks (every SRCU reader may, and the port's spinlocks can) moves to another CPU: its section ends on the wrong
+ * record, the first CPU keeps interrupts off for whoever runs there next, and synchronize_rcu spins forever with
+ * interrupts off (panic "TLB flush timeout" in linux_file_close, test 20). Readers here only count themselves in one
+ * of two global counters per type, with no pinning and no interrupt change, so they may block and move freely.
+ * synchronize_rcu waits out the counter older readers use, flips new readers to it, and waits out the other one
+ * (the classic two-counter SRCU grace period). The full fences pair with the reader's: a reader that counts itself
+ * after the updater saw zero also sees the updater's earlier stores.
+ */
+static volatile int nmx_rcu_idx[RCU_TYPE_MAX];
+static volatile int nmx_rcu_readers[RCU_TYPE_MAX][2];
+static volatile int nmx_rcu_sync_busy[RCU_TYPE_MAX];
+volatile int nmx_rcu_waiting;	/* synchronize_rcu calls waiting now, for the heartbeat */
+
+void
+linux_rcu_read_lock(unsigned type)
+{
+	struct task_struct *ts;
+	int idx;
+
+	MPASS(type < RCU_TYPE_MAX);
+
+	if (RCU_SKIP())
+		return;
+
+	ts = current;
+
+	/* assert valid refcount */
+	MPASS(ts->rcu_recurse[type] != INT_MAX);
+
+	if (++(ts->rcu_recurse[type]) != 1)
+		return;
+
+	idx = __atomic_load_n(&nmx_rcu_idx[type], __ATOMIC_SEQ_CST) & 1;
+	__atomic_fetch_add(&nmx_rcu_readers[type][idx], 1, __ATOMIC_SEQ_CST);
+	__atomic_thread_fence(__ATOMIC_SEQ_CST);
+	ts->rcu_section[type] = idx;
+}
+
+void
+linux_rcu_read_unlock(unsigned type)
+{
+	struct task_struct *ts;
+
+	MPASS(type < RCU_TYPE_MAX);
+
+	if (RCU_SKIP())
+		return;
+
+	ts = current;
+
+	/* assert valid refcount */
+	MPASS(ts->rcu_recurse[type] > 0);
+
+	if (--(ts->rcu_recurse[type]) != 0)
+		return;
+
+	__atomic_thread_fence(__ATOMIC_SEQ_CST);
+	__atomic_fetch_sub(&nmx_rcu_readers[type][ts->rcu_section[type] & 1], 1, __ATOMIC_SEQ_CST);
+}
+
+bool
+linux_rcu_read_lock_held(unsigned type)
+{
+	if (RCU_SKIP())
+		return (false);
+	return (curthread->td_lkpi_task != NULL &&
+	    current->rcu_recurse[type] != 0);
+}
+
+/* sleep (never spin with interrupts off) until no reader counts in *c */
+static void
+nmx_rcu_wait_zero(volatile int *c)
+{
+	int n;
+
+	for (n = 0; __atomic_load_n(c, __ATOMIC_SEQ_CST) != 0; n++) {
+		if (n < 32)
+			mi_switch(SW_VOL);
+		else
+			pause("rcu", 1);
+	}
+}
+
+void
+linux_synchronize_rcu(unsigned type)
+{
+	int n, idx;
+
+	MPASS(type < RCU_TYPE_MAX);
+
+	if (RCU_SKIP())
+		return;
+
+	__atomic_fetch_add(&nmx_rcu_waiting, 1, __ATOMIC_SEQ_CST);
+
+	/* one grace period at a time per type, so the flip below is ours */
+	for (n = 0; __atomic_exchange_n(&nmx_rcu_sync_busy[type], 1, __ATOMIC_SEQ_CST) != 0; n++) {
+		if (n < 32)
+			mi_switch(SW_VOL);
+		else
+			pause("rcu", 1);
+	}
+
+	__atomic_thread_fence(__ATOMIC_SEQ_CST);
+	idx = __atomic_load_n(&nmx_rcu_idx[type], __ATOMIC_SEQ_CST) & 1;
+	/* stragglers that read the index before the last flip and counted in the other counter */
+	nmx_rcu_wait_zero(&nmx_rcu_readers[type][idx ^ 1]);
+	__atomic_store_n(&nmx_rcu_idx[type], idx ^ 1, __ATOMIC_SEQ_CST);
+	__atomic_thread_fence(__ATOMIC_SEQ_CST);
+	/* every reader that started before the flip */
+	nmx_rcu_wait_zero(&nmx_rcu_readers[type][idx]);
+	__atomic_thread_fence(__ATOMIC_SEQ_CST);
+
+	__atomic_store_n(&nmx_rcu_sync_busy[type], 0, __ATOMIC_SEQ_CST);
+	__atomic_fetch_sub(&nmx_rcu_waiting, 1, __ATOMIC_SEQ_CST);
+}
+
+void
+linux_rcu_barrier(unsigned type)
+{
+	struct linux_epoch_head *head;
+
+	MPASS(type < RCU_TYPE_MAX);
+
+	/*
+	 * This function is not obligated to wait for a grace period.
+	 * It only waits for RCU callbacks that have already been posted.
+	 * If there are no RCU callbacks posted, rcu_barrier() can return
+	 * immediately.
+	 */
+	head = &linux_epoch_head[type];
+
+	/* wait for callbacks to complete */
+	taskqueue_drain(linux_irq_work_tq, &head->task);
+}
+
+void
+linux_call_rcu(unsigned type, struct rcu_head *context, rcu_callback_t func)
+{
+	struct callback_head *rcu;
+	struct linux_epoch_head *head;
+
+	MPASS(type < RCU_TYPE_MAX);
+
+	rcu = (struct callback_head *)context;
+	head = &linux_epoch_head[type];
+
+	rcu->func = func;
+	llist_add(&rcu->node, &head->cb_head);
+	taskqueue_enqueue(linux_irq_work_tq, &head->task);
+}
+
+int
+init_srcu_struct(struct srcu_struct *srcu)
+{
+	return (0);
+}
+
+void
+cleanup_srcu_struct(struct srcu_struct *srcu)
+{
+}
+
+int
+srcu_read_lock(struct srcu_struct *srcu)
+{
+	linux_rcu_read_lock(RCU_TYPE_SLEEPABLE);
+	return (0);
+}
+
+void
+srcu_read_unlock(struct srcu_struct *srcu, int key __unused)
+{
+	linux_rcu_read_unlock(RCU_TYPE_SLEEPABLE);
+}
+
+void
+synchronize_srcu(struct srcu_struct *srcu)
+{
+	linux_synchronize_rcu(RCU_TYPE_SLEEPABLE);
+}
+
+void
+srcu_barrier(struct srcu_struct *srcu)
+{
+	linux_rcu_barrier(RCU_TYPE_SLEEPABLE);
+}
diff --git a/gpu-port/xkpi/xnu/nmx_kext.cpp b/gpu-port/xkpi/xnu/nmx_kext.cpp
index f4f533e..2964501 100644
--- a/gpu-port/xkpi/xnu/nmx_kext.cpp
+++ b/gpu-port/xkpi/xnu/nmx_kext.cpp
@@ -248,22 +248,21 @@ extern "C" void nmx_xnu_trail(const char *step)
  * "nullmoth-gpu-io": what user space asks of the GPU, written to NVRAM as it happens, so a boot that freezes shows
  * the request in flight. Tokens: "o<pid>" an open, "c" a close, "<g><nr>" an ioctl starting (g is the ioctl group
  * letter: d = DRM, N = the port's mmap), "+" one that returned 0, "-<errno>" one that failed. The newest 470
- * characters are kept; writing stops after 400 tokens (the start is what matters).
+ * characters are kept. The first 400 tokens are each written as they happen; after that the buffer still follows
+ * every token and the heartbeat writes it when it changed, so the end before a freeze is there too (0021).
  */
 static IOLock *gIoLock;
 static char gIo[480];
 static unsigned gIoWrites;
+static bool gIoDirty;
+
+static void nmx_io_write_locked();
 
 extern "C" void nmx_xnu_iolog(const char *tok)
 {
     if (gIoLock == nullptr || tok == nullptr)
         return;
     IOLockLock(gIoLock);
-    if (gIoWrites >= 400) {
-        IOLockUnlock(gIoLock);
-        return;
-    }
-    gIoWrites++;
     size_t len = strlen(gIo), add = strlen(tok);
     while (len + add + 2 > sizeof(gIo) - 10) {       /* drop the oldest token */
         char *sp = strchr(gIo, ' ');
@@ -274,6 +273,18 @@ extern "C" void nmx_xnu_iolog(const char *tok)
     if (len)
         gIo[len++] = ' ';
     memcpy(gIo + len, tok, add + 1);
+    if (gIoWrites >= 400)
+        gIoDirty = true;
+    else {
+        gIoWrites++;
+        nmx_io_write_locked();
+    }
+    IOLockUnlock(gIoLock);
+}
+
+static void nmx_io_write_locked()
+{
+    gIoDirty = false;
     IODTNVRAM *n = nmx_nvram();
     if (n != nullptr) {
         const OSSymbol *k = OSSymbol::withCString("nullmoth-gpu-io");
@@ -287,7 +298,6 @@ extern "C" void nmx_xnu_iolog(const char *tok)
         n->sync();
         n->release();
     }
-    IOLockUnlock(gIoLock);
 }
 
 /* the trail plus, at its end, the heartbeat's latest " @<ms since the attach began>" (gTrailBeat) */
@@ -353,6 +363,8 @@ static void nmx_beat_write(const char *s)
     n->release();
 }
 
+extern "C" volatile int nmx_rcu_waiting;
+
 static void nmx_beat_thread(void *, wait_result_t)
 {
     char s[128];
@@ -366,9 +378,15 @@ static void nmx_beat_thread(void *, wait_result_t)
         int opens, ioctls, inside;
         uint32_t cmd;
         nmx_xnu_node_stats(&opens, &ioctls, &inside, &cmd);
-        snprintf(s, sizeof(s), "ms=%lld pub=%lld open=%d ioctl=%d in=%d cmd=0x%x", nmx_ms_since(gAttachStart),
-                 nmx_ms_since(gPublished), opens, ioctls, inside, cmd);
+        snprintf(s, sizeof(s), "ms=%lld pub=%lld open=%d ioctl=%d in=%d cmd=0x%x rcu=%d", nmx_ms_since(gAttachStart),
+                 nmx_ms_since(gPublished), opens, ioctls, inside, cmd, nmx_rcu_waiting);
         nmx_beat_write(s);
+        if (gIoLock != nullptr) {
+            IOLockLock(gIoLock);
+            if (gIoDirty)
+                nmx_io_write_locked();
+            IOLockUnlock(gIoLock);
+        }
     }
     thread_terminate(current_thread());
 }
