From bb0cc6a7a874532d6631d4252b7514ba5a748655 Mon Sep 17 00:00:00 2001
From: kitsuneislife <kitsuneislife@users.noreply.github.com>
Date: Sat, 17 Oct 2026 12:56:21 -0300
Subject: [PATCH] Poll the interrupt handler while waiting for an MCU reply

---
 SimpleMtkWlan/hal_mwx/MtkMwx.cpp | 48 +++++++++++++++++++++++++++++---
 1 file changed, 44 insertions(+), 4 deletions(-)

diff --git a/SimpleMtkWlan/hal_mwx/MtkMwx.cpp b/SimpleMtkWlan/hal_mwx/MtkMwx.cpp
index 7a7ef24..e32f1fe 100644
--- a/SimpleMtkWlan/hal_mwx/MtkMwx.cpp
+++ b/SimpleMtkWlan/hal_mwx/MtkMwx.cpp
@@ -2086,8 +2086,8 @@ mwx_count_nodes(struct ieee80211com *ic)
 /*
  * Driver specific functions.
  */
-int
-mwx_intr(void *arg)
+static int
+mwx_intr_locked(void *arg)
 {
 	struct mwx_softc *sc = (struct mwx_softc *)arg;
 	uint32_t intr, intr_sw;
@@ -2162,6 +2162,27 @@ mwx_intr(void *arg)
 	return 1;
 }
 
+/*
+ * The interrupt handler runs on the driver workloop. MCU commands issued from
+ * inside the workloop gate (start, enable) wait for a reply that the handler
+ * cannot process until the gate is released, so mwx_mcu_wait() polls it too.
+ * The guard keeps the two callers from running the handler at once; a call
+ * that loses the race returns, and the winner sees the same status bits.
+ */
+static volatile int mwx_intr_busy;
+
+int
+mwx_intr(void *arg)
+{
+	int rv;
+
+	if (__sync_lock_test_and_set(&mwx_intr_busy, 1))
+		return 0;
+	rv = mwx_intr_locked(arg);
+	__sync_lock_release(&mwx_intr_busy);
+	return rv;
+}
+
 int
 mwx_preinit(struct mwx_softc *sc)
 {
@@ -3848,6 +3869,25 @@ mwx_mcu_rx_event(struct mwx_softc *sc, struct mbuf *m)
 	m_freem(m);
 }
 
+/*
+ * Wait up to 3 s for the reply to MCU command seq. Polls the interrupt
+ * handler every 2 ms (see mwx_intr()), so a reply that arrives while the
+ * caller holds the workloop gate is still seen.
+ */
+static int
+mwx_mcu_wait(struct mwx_softc *sc, int seq)
+{
+	for (int ms = 0; ms < 3000; ms += 2) {
+		if (sc->sc_mcu_wait[seq].mcu_m != NULL)
+			return 0;
+		mwx_intr((void *)sc);
+		if (sc->sc_mcu_wait[seq].mcu_m != NULL)
+			return 0;
+		tsleep_nsec(&sc->sc_mcu_wait[seq], 0, "mwxwait", MSEC_TO_NSEC(2));
+	}
+	return sc->sc_mcu_wait[seq].mcu_m != NULL ? 0 : EWOULDBLOCK;
+}
+
 /*
  * Called when an MCU command times out: shows whether the device fetched the
  * command (TX MCU ring DMA index), answered it (RX MCU ring DMA index) and
@@ -3882,7 +3922,7 @@ mwx_mcu_wait_resp_int(struct mwx_softc *sc, uint32_t cmd, int seq,
 
 	KASSERT(seq < nitems(sc->sc_mcu_wait));
 
-	rv = tsleep_nsec(&sc->sc_mcu_wait[seq], 0, "mwxwait", SEC_TO_NSEC(3));
+	rv = mwx_mcu_wait(sc, seq);
 	if (rv != 0) {
 		printf("%s: command %x timeout\n", DEVNAME(sc), cmd);
 		mwx_mcu_dump_state(sc, cmd);
@@ -3907,7 +3947,7 @@ mwx_mcu_wait_resp_msg(struct mwx_softc *sc, uint32_t cmd, int seq,
 
 	KASSERT(seq < nitems(sc->sc_mcu_wait));
 
-	rv = tsleep_nsec(&sc->sc_mcu_wait[seq], 0, "mwxwait", SEC_TO_NSEC(3));
+	rv = mwx_mcu_wait(sc, seq);
 	if (rv != 0) {
 		printf("%s: command %x timeout\n", DEVNAME(sc), cmd);
 		mwx_mcu_dump_state(sc, cmd);
