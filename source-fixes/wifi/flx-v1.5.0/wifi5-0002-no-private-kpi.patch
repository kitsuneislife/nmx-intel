From a2753b57d6b66a1b7596fc9e60957bedd40ef693 Mon Sep 17 00:00:00 2001
From: kitsuneislife <kitsuneislife@users.noreply.github.com>
Date: Sun, 18 Oct 2026 15:19:23 -0300
Subject: [PATCH] taskq_quiesce: count in-flight invocations instead of private
 thread_call_cancel_wait

kmutil refuses to link thread_call_cancel_wait (com.apple.kpi.private) into a third-party
kext. task_add counts each invocation thread_call_enter schedules, taskq_run uncounts on
return, thread_call_cancel uncounts one it removed; quiesce waits (bounded, 5 s) for zero.
The host test's thread_call stub follows xnu's THREAD_CALL_ONCE semantics.
---
 mtk80211/openbsd/sys/_task.cpp | 26 +++++++++++++++++++++++---
 tests/lifecycle/test-queue.py  | 11 +++++++----
 2 files changed, 30 insertions(+), 7 deletions(-)

diff --git a/mtk80211/openbsd/sys/_task.cpp b/mtk80211/openbsd/sys/_task.cpp
index 0a0096e..ceaac22 100644
--- a/mtk80211/openbsd/sys/_task.cpp
+++ b/mtk80211/openbsd/sys/_task.cpp
@@ -40,6 +40,7 @@ struct taskq {
     thread_call_t call;
     struct task_list work;
     bool stopping;
+    int inflight;   /* invocations scheduled and not yet returned, under lock (replaces thread_call_cancel_wait) */
 };
 static struct taskq system_queue;
 struct taskq *const systq = &system_queue;
@@ -51,6 +52,7 @@ static void taskq_run(thread_call_param_t arg, thread_call_param_t)
         IORecursiveLockLock(q->lock);
         struct task *item = TAILQ_FIRST(&q->work);
         if (q->stopping || item == NULL) {
+            q->inflight--;
             IORecursiveLockUnlock(q->lock);
             return;
         }
@@ -68,6 +70,7 @@ static bool taskq_setup(struct taskq *q)
     if (!q->lock) return false;
     TAILQ_INIT(&q->work);
     q->stopping = false;
+    q->inflight = 0;
     q->call = thread_call_allocate_with_options(taskq_run, q,
         THREAD_CALL_PRIORITY_KERNEL, THREAD_CALL_OPTIONS_ONCE);
     if (!q->call) {
@@ -107,7 +110,22 @@ void taskq_quiesce(struct taskq *q)
     }
     IORecursiveLockUnlock(q->lock);
     /* task_add and resubmission are now rejected under the same lock. */
-    thread_call_cancel_wait(q->call);
+    /* thread_call_cancel_wait is private KPI (kmutil refuses to link it). thread_call_cancel returns TRUE when it
+       removed a scheduled invocation (also a running ONCE call's reschedule); then wait until every invocation that
+       did start has returned (each one sees `stopping` and takes no work). Bounded like the ring log's stop. */
+    if (thread_call_cancel(q->call)) {
+        IORecursiveLockLock(q->lock);
+        q->inflight--;
+        IORecursiveLockUnlock(q->lock);
+    }
+    for (int i = 0; i < 5000; i++) {
+        IORecursiveLockLock(q->lock);
+        int n = q->inflight;
+        IORecursiveLockUnlock(q->lock);
+        if (n <= 0) return;
+        IOSleep(1);
+    }
+    IOLog("SimpleMtkWlan: taskq_quiesce: callback still running after 5 s\n");
 }
 
 void taskq_destroy(struct taskq *q)
@@ -139,8 +157,10 @@ int task_add(struct taskq *q, struct task *t)
     }
     t->t_flags |= TASK_ONQUEUE;
     TAILQ_INSERT_TAIL(&q->work, t, t_entry);
-    /* Submit while locked, so shutdown cannot miss a late submission. */
-    thread_call_enter(q->call);
+    /* Submit while locked, so shutdown cannot miss a late submission. FALSE = a new invocation was scheduled
+       (TRUE: one is already pending and will see this task). */
+    if (!thread_call_enter(q->call))
+        q->inflight++;
     IORecursiveLockUnlock(q->lock);
     return 1;
 }
diff --git a/tests/lifecycle/test-queue.py b/tests/lifecycle/test-queue.py
index cc97416..35ad2ec 100644
--- a/tests/lifecycle/test-queue.py
+++ b/tests/lifecycle/test-queue.py
@@ -22,16 +22,19 @@ void IORecursiveLockLock(IORecursiveLock*p){p->lock();}
 void IORecursiveLockUnlock(IORecursiveLock*p){p->unlock();}
 void* IOMalloc(size_t n){return malloc(n);}void IOFree(void*p,size_t){free(p);}
 using thread_call_param_t=void*;
-struct Call{void(*fn)(void*,void*);void*arg;std::mutex m;std::condition_variable cv;bool pending=false,running=false,stop=false;std::thread worker;};
+struct Call{void(*fn)(void*,void*);void*arg;std::mutex m;std::condition_variable cv;bool pending=false,running=false,resched=false,stop=false;std::thread worker;};
 using thread_call_t=Call*;
 #define THREAD_CALL_PRIORITY_KERNEL 1
 #define THREAD_CALL_OPTIONS_ONCE 1
 Call*thread_call_allocate_with_options(void(*fn)(void*,void*),void*arg,int,int){
  auto*c=new Call;c->fn=fn;c->arg=arg;
- c->worker=std::thread([c]{std::unique_lock<std::mutex> l(c->m);for(;;){c->cv.wait(l,[c]{return c->pending||c->stop;});if(c->stop)return;c->pending=false;c->running=true;l.unlock();c->fn(c->arg,nullptr);l.lock();c->running=false;c->cv.notify_all();}});return c;
+ c->worker=std::thread([c]{std::unique_lock<std::mutex> l(c->m);for(;;){c->cv.wait(l,[c]{return c->pending||c->stop;});if(c->stop)return;c->pending=false;c->running=true;l.unlock();c->fn(c->arg,nullptr);l.lock();c->running=false;if(c->resched){c->resched=false;c->pending=true;}c->cv.notify_all();}});return c;
 }
-void thread_call_enter(Call*c){std::lock_guard<std::mutex> l(c->m);c->pending=true;c->cv.notify_all();}
-void thread_call_cancel_wait(Call*c){std::unique_lock<std::mutex> l(c->m);c->pending=false;c->cv.wait(l,[c]{return !c->running;});}
+// xnu THREAD_CALL_ONCE: entering a running call reschedules it once; enter returns TRUE if nothing new was scheduled
+bool thread_call_enter(Call*c){std::lock_guard<std::mutex> l(c->m);bool r;if(c->running){r=c->resched;c->resched=true;}else{r=c->pending;c->pending=true;}c->cv.notify_all();return r;}
+bool thread_call_cancel(Call*c){std::lock_guard<std::mutex> l(c->m);if(c->pending){c->pending=false;return true;}if(c->resched){c->resched=false;return true;}return false;}
+void IOSleep(unsigned ms){std::this_thread::sleep_for(std::chrono::milliseconds(ms));}
+int IOLog(const char*,...){return 0;}
 bool thread_call_free(Call*c){{std::lock_guard<std::mutex> l(c->m);c->stop=true;c->cv.notify_all();}c->worker.join();delete c;return true;}
 struct task{TAILQ_ENTRY(task)t_entry;void(*t_func)(void*);void*t_arg;unsigned t_flags;char name[256];};
 TAILQ_HEAD(task_list,task);
-- 
