diff --git a/gpu-port/xkpi/override/i915/nmx_i915_fb.c b/gpu-port/xkpi/override/i915/nmx_i915_fb.c
index c2ea4c7..531b31f 100644
--- a/gpu-port/xkpi/override/i915/nmx_i915_fb.c
+++ b/gpu-port/xkpi/override/i915/nmx_i915_fb.c
@@ -40,6 +40,13 @@ struct nmx_i915_fb {
     struct i915_vma *vma;
     unsigned long vma_flags;
     void __iomem *vaddr;
+    /*
+     * Held for as long as macOS has the buffer: WindowServer writes it through the aperture with plain CPU stores,
+     * and the aperture must not be touched while the GPU is runtime suspended (Linux revokes GGTT mmaps before
+     * suspending; here nothing would). Tests 6-8 froze a few seconds after WindowServer started drawing.
+     */
+    struct drm_i915_private *i915;
+    intel_wakeref_t wakeref;
 };
 
 /* the boot framebuffer's GGTT range, held from init_ggtt until the bridge binds the boot buffer there */
@@ -276,7 +283,8 @@ int nmx_i915_fb_create(struct drm_device *drm, uint32_t width, uint32_t height,
         printf("NullMoth display: the buffer would not map through the aperture (%d)\n", ret);
         goto out_unpin;
     }
-    intel_runtime_pm_put(&i915->runtime_pm, wakeref);
+    f->i915 = i915;
+    f->wakeref = wakeref;           /* kept until nmx_i915_fb_destroy */
 
     out->fb = fb;
     out->pitch = fb->pitches[0];
@@ -287,8 +295,8 @@ int nmx_i915_fb_create(struct drm_device *drm, uint32_t width, uint32_t height,
     /* the boot buffer keeps what the console drew; a new one may hold whatever stolen held before */
     if (strcmp(where, "the boot framebuffer") != 0)
         memset_io(f->vaddr, 0, size);
-    printf("NullMoth display: i915 buffer in %s, GGTT 0x%08x, aperture 0x%llx\n", where, i915_ggtt_offset(vma),
-           (unsigned long long)out->phys);
+    printf("NullMoth display: i915 buffer in %s, GGTT 0x%08x, aperture 0x%llx; GPU kept awake while it is shown\n",
+           where, i915_ggtt_offset(vma), (unsigned long long)out->phys);
     return 0;
 
 out_unpin:
@@ -319,5 +327,7 @@ void nmx_i915_fb_destroy(void *priv)
     if (f->vma != NULL)
         intel_fb_unpin_vma(f->vma, f->vma_flags);
     drm_framebuffer_remove(f->fb);  /* turns off any plane still scanning it out, then drops it */
+    if (f->i915 != NULL)
+        intel_runtime_pm_put(&f->i915->runtime_pm, f->wakeref);
     kfree(f);
 }
diff --git a/gpu-port/xkpi/xnu/nmx_platform.cpp b/gpu-port/xkpi/xnu/nmx_platform.cpp
index 6bef370..497106a 100644
--- a/gpu-port/xkpi/xnu/nmx_platform.cpp
+++ b/gpu-port/xkpi/xnu/nmx_platform.cpp
@@ -522,8 +522,11 @@ extern "C" int nmx_xnu_boot_fb(uint64_t *phys, uint32_t *width, uint32_t *height
     IOPlatformExpert *pe = IOService::getPlatform();
     if (pe == NULL || pe->getConsoleInfo(&v) != kIOReturnSuccess || v.v_baseAddr == 0 || v.v_depth != 32)
         return 0;
-    /* on x86_64 the console info keeps the boot arguments' 64-bit physical base */
-    *phys = (uint64_t)v.v_baseAddr + v.v_offset;
+    /*
+     * on x86_64 the console info keeps the boot arguments' 64-bit physical base, with flags in the low bits
+     * (test 8: 0x4000000001 for a buffer at 0x4000000000); the buffer itself is page aligned
+     */
+    *phys = ((uint64_t)v.v_baseAddr & ~(uint64_t)0xfff) + v.v_offset;
     *width = (uint32_t)v.v_width;
     *height = (uint32_t)v.v_height;
     *pitch = (uint32_t)v.v_rowBytes;
