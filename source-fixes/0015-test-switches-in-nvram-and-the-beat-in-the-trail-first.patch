+/*
+ * A test switch: the boot argument if it is set, else the NVRAM variable (one decimal number as text, set with
+ * "sudo nvram nullmoth-gpu-fb=2", removed with "sudo nvram -d nullmoth-gpu-fb"), else the default.
+ */
+extern "C" uint32_t nmx_xnu_knob(const char *bootarg, const char *nvvar, uint32_t def)
+{
+    uint32_t v;
+    if (PE_parse_boot_argn(bootarg, &v, sizeof(v)))
+        return v;
+    IODTNVRAM *n = nmx_nvram();
+    if (n == nullptr)
+        return def;
+    OSObject *o = n->copyProperty(nvvar);
+    OSData *d = OSDynamicCast(OSData, o);
+    if (d != nullptr && d->getLength() > 0) {
+        const char *p = (const char *)d->getBytesNoCopy();
+        v = 0;
+        for (unsigned i = 0; i < d->getLength() && p[i] >= '0' && p[i] <= '9'; i++)
+            v = v * 10 + (uint32_t)(p[i] - '0');
+        def = v;
+    }
+    if (o != nullptr)
+        o->release();
+    n->release();
+    return def;
+}
