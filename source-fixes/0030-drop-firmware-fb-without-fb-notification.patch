From 6544d66a281327579b7e82d22a5a121e5d3e8563 Mon Sep 17 00:00:00 2001
From: kitsuneislife <kitsuneislif3@gmail.com>
Date: Fri, 16 Oct 2026 17:06:51 -0300
Subject: [PATCH] nmx-intel 0030: drop the firmware framebuffer with
 IOService::terminate

---
 gpu-port/xkpi/xnu/nmx_fb.cpp | 6 +++++-
 1 file changed, 5 insertions(+), 1 deletion(-)

diff --git a/gpu-port/xkpi/xnu/nmx_fb.cpp b/gpu-port/xkpi/xnu/nmx_fb.cpp
index a23ecfc..56e75d4 100644
--- a/gpu-port/xkpi/xnu/nmx_fb.cpp
+++ b/gpu-port/xkpi/xnu/nmx_fb.cpp
@@ -299,7 +299,11 @@ static void ndrvDropThread(void *p, wait_result_t)
                 continue;
             IOSleep(2000);                 /* let WindowServer finish bringing it up */
             nmx_xnu_trail("ndrv-term");
-            s->terminate();
+            /* nmx-intel 0030: IOService's terminate, not IOFramebuffer's. IOFramebuffer::terminate delivers
+               kIOFBNotifyTerminated, and AppleUpstreamUserClientDriver::fbNotificationOccurred dereferences NULL on it
+               (test 29 panic, CR2 0). The plain IOService termination still stops the framebuffer and its clients,
+               and IOFramebuffer::stop does the cleanup. */
+            s->IOService::terminate();
             nmx_xnu_trail("ndrv-gone");
             left--;
         }
-- 
