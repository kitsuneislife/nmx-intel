 };
 
+/* the boot framebuffer as an offset in the GGTT; false if there is none or it is not in the aperture */
+static bool boot_fb_ggtt(struct i915_ggtt *ggtt, u32 *base, u32 *size, u32 *width, u32 *height, u32 *pitch)
+{
+    uint64_t phys;
+    if (!nmx_xnu_boot_fb(&phys, width, height, pitch))
+        return false;
+    *size = round_up(*pitch * *height, I915_GTT_PAGE_SIZE);
+    if (phys < ggtt->gmadr.start || phys + *size > ggtt->gmadr.end + 1 ||
+        !IS_ALIGNED(phys - ggtt->gmadr.start, I915_GTT_PAGE_SIZE)) {
+        printf("NullMoth display: the boot framebuffer 0x%llx is not in the GGTT aperture 0x%llx-0x%llx\n",
+               (unsigned long long)phys, (unsigned long long)ggtt->gmadr.start,
+               (unsigned long long)ggtt->gmadr.end);
+        return false;
+    }
+    *base = (u32)(phys - ggtt->gmadr.start);
+    return true;
+}
+
+/*
+ * The boot framebuffer's stolen pages, as a preallocated stolen object bound at its own GGTT offset. NULL (and the
+ * reason in the log) if the GGTT does not map it to one contiguous run of stolen memory or the range is taken.
+ */
+static struct i915_vma *take_boot_fb(struct drm_i915_private *i915, u32 base, u32 size)
+{
+    struct i915_ggtt *ggtt = to_gt(i915)->ggtt;
+    struct intel_memory_region *mem = i915->mm.stolen_region;
+    gen8_pte_t __iomem *gte = (gen8_pte_t __iomem *)ggtt->gsm + base / I915_GTT_PAGE_SIZE;
+    struct drm_i915_gem_object *obj;
+    struct i915_vma *vma;
+    u64 pte, dma, off;
+    int err;
+
+    if (mem == NULL) {
+        printf("NullMoth display: i915 has no stolen memory region\n");
+        return NULL;
+    }
+    pte = ioread64(gte);
+    dma = pte & GEN12_GGTT_PTE_ADDR_MASK;
+    if (!(pte & GEN8_PAGE_PRESENT) || dma < mem->region.start || dma + size > mem->region.end + 1) {
+        printf("NullMoth display: GGTT 0x%x maps 0x%llx, not usable stolen memory (0x%llx-0x%llx)\n", base,
+               (unsigned long long)pte, (unsigned long long)mem->region.start,
+               (unsigned long long)mem->region.end);
+        return NULL;
+    }
+    for (u32 i = 1; i < size / I915_GTT_PAGE_SIZE; i++)
+        if ((ioread64(gte + i) & GEN12_GGTT_PTE_ADDR_MASK) != dma + (u64)i * I915_GTT_PAGE_SIZE) {
+            printf("NullMoth display: the boot framebuffer is not one run of stolen memory (page %u)\n", i);
+            return NULL;
+        }
+    off = dma - mem->region.start;
+
+    obj = i915_gem_object_create_region_at(mem, off, size, I915_BO_ALLOC_USER | I915_BO_PREALLOC);
+    if (IS_ERR(obj)) {
+        printf("NullMoth display: stolen 0x%llx+0x%x is taken (%ld)\n", (unsigned long long)off, size,
+               PTR_ERR(obj));
+        return NULL;
+    }
+    /* WT ahead of time, as intel_plane_initial.c does, so pinning for display does not change the cache level */
+    i915_gem_object_set_cache_coherency(obj, HAS_WT(i915) ? I915_CACHE_WT : I915_CACHE_NONE);
+
+    vma = i915_vma_instance(obj, &ggtt->vm, NULL);
+    if (IS_ERR(vma)) {
+        i915_gem_object_put(obj);
+        return NULL;
+    }
+    err = i915_vma_pin(vma, 0, 0, PIN_GLOBAL | PIN_OFFSET_FIXED | PIN_MAPPABLE | base);
+    if (err) {
+        printf("NullMoth display: GGTT 0x%x+0x%x is taken (%d)\n", base, size, err);
+        i915_gem_object_put(obj);
+        return NULL;
+    }
+    printf("NullMoth display: took over the boot framebuffer: stolen 0x%llx, GGTT 0x%x, %u KiB\n",
+           (unsigned long long)off, base, size >> 10);
+    return vma;     /* holds the object reference and one pin */
+}
