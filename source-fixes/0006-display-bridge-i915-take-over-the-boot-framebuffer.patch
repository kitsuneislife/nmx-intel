+/*
+ * The boot framebuffer (the firmware's GOP buffer that the kernel's console draws into): its physical address and
+ * geometry from the platform expert's console info. 0 when there is none or it is not 32 bits per pixel.
+ */
+extern "C" int nmx_xnu_boot_fb(uint64_t *phys, uint32_t *width, uint32_t *height, uint32_t *pitch)
+{
+    PE_Video v;
+    bzero(&v, sizeof(v));
+    IOPlatformExpert *pe = IOService::getPlatform();
+    if (pe == NULL || pe->getConsoleInfo(&v) != kIOReturnSuccess || v.v_baseAddr == 0 || v.v_depth != 32)
+        return 0;
+    /* on x86_64 the console info keeps the boot arguments' 64-bit physical base */
+    *phys = (uint64_t)v.v_baseAddr + v.v_offset;
+    *width = (uint32_t)v.v_width;
+    *height = (uint32_t)v.v_height;
+    *pitch = (uint32_t)v.v_rowBytes;
+    return 1;
+}
