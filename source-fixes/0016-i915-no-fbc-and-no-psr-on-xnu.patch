@@ -22,6 +22,18 @@ struct drm_printer;
  * mode: debugfs file permissions, one of {0400, 0600, 0}, use 0 to not create
  *       debugfs file
  */
+/*
+ * NMXKPI: no FBC and no PSR. macOS draws the scan-out buffer with plain CPU stores through the GGTT aperture
+ * (the console, IONDRVFramebuffer, WindowServer), which i915's frontbuffer tracking never sees: with FBC the plane
+ * keeps showing the compressed copy, and with PSR the panel keeps showing its own copy. Test 15: after the bridge's
+ * modeset the panel froze on the frame of that moment while the Mac ran on.
+ */
+#ifdef NMXKPI
+#define NMX_FBC_PSR_DEFAULT 0
+#else
+#define NMX_FBC_PSR_DEFAULT -1
+#endif
+
 #define INTEL_DISPLAY_PARAMS_FOR_EACH(param) \
