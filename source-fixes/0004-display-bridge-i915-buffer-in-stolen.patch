diff --git a/gpu-port/xkpi/override/i915/nmx_i915_fb.c b/gpu-port/xkpi/override/i915/nmx_i915_fb.c
new file mode 100644
index 0000000..6126a20
--- /dev/null
+++ b/gpu-port/xkpi/override/i915/nmx_i915_fb.c
@@ -0,0 +1,142 @@
+/*
+ * The display bridge's scan-out buffer on i915 (Intel integrated graphics).
+ *
+ * The generic bridge (override/src/nmx_fb_bridge.c) creates a dumb buffer and maps it with drm_client_buffer_vmap.
+ * i915's GEM objects have no .vmap, and their shmem pages are scattered, so neither the mapping nor the single
+ * physical range the IOFramebuffer publishes would exist. This does what i915's own fbdev does (intel_fbdev.c,
+ * intel_fbdev_fb.c): a buffer in stolen memory (shmem if stolen is short), pinned into the mappable GGTT. The CPU
+ * reaches it through the GGTT aperture (BAR2), where the buffer is one contiguous range whatever pages back it, so
+ * that aperture range is what macOS gets as the framebuffer's VRAM, exactly as fbdev publishes it as smem_start.
+ */
+#include <drm/drm_framebuffer.h>
+#include <drm/drm_fourcc.h>
+
+#include "gem/i915_gem_stolen.h"
+#include "gt/intel_gt.h"
+#include "i915_drv.h"
+#include "i915_vma.h"
+#include "display/intel_display_types.h"
+#include "display/intel_fb.h"
+#include "display/intel_fb_pin.h"
+
+#include "nmx_i915_fb.h"
+
+struct nmx_i915_fb {
+    struct drm_framebuffer *fb;
+    struct i915_vma *vma;
+    unsigned long vma_flags;
+    void __iomem *vaddr;
+};
+
+int nmx_i915_fb_create(struct drm_device *drm, uint32_t width, uint32_t height, struct nmx_i915_fb_out *out)
+{
+    struct drm_i915_private *i915 = to_i915(drm);
+    const struct i915_gtt_view view = { .type = I915_GTT_VIEW_NORMAL };
+    struct drm_mode_fb_cmd2 mode_cmd = {};
+    struct drm_i915_gem_object *obj = ERR_PTR(-ENODEV);
+    struct i915_gem_ww_ctx ww;
+    intel_wakeref_t wakeref;
+    struct nmx_i915_fb *f;
+    struct i915_vma *vma;
+    struct drm_framebuffer *fb;
+    const char *where = "stolen";
+    int size, ret;
+
+    memset(out, 0, sizeof(*out));
+    mode_cmd.width = width;
+    mode_cmd.height = height;
+    mode_cmd.pitches[0] = ALIGN(width * 4, 64);
+    mode_cmd.pixel_format = DRM_FORMAT_XRGB8888;
+    size = PAGE_ALIGN(mode_cmd.pitches[0] * height);
+
+    f = kzalloc(sizeof(*f), GFP_KERNEL);
+    if (f == NULL)
+        return -ENOMEM;
+
+    /* intel_fbdev_fb_alloc's choice: stolen unless it would take more than half of it (and never on Meteor Lake) */
+    if (!IS_METEORLAKE(i915) && size * 2 < i915->dsm.usable_size)
+        obj = i915_gem_object_create_stolen(i915, size);
+    if (IS_ERR(obj)) {
+        where = "shmem";
+        obj = i915_gem_object_create_shmem(i915, size);
+    }
+    if (IS_ERR(obj)) {
+        printf("NullMoth display: i915 has no memory for a %ux%u buffer (%ld)\n", width, height, PTR_ERR(obj));
+        kfree(f);
+        return PTR_ERR(obj);
+    }
+    fb = intel_framebuffer_create(intel_bo_to_drm_bo(obj), &mode_cmd);
+    i915_gem_object_put(obj);       /* the framebuffer holds its own reference */
+    if (IS_ERR(fb)) {
+        printf("NullMoth display: i915 refused the framebuffer (%ld)\n", PTR_ERR(fb));
+        kfree(f);
+        return PTR_ERR(fb);
+    }
+    f->fb = fb;
+
+    wakeref = intel_runtime_pm_get(&i915->runtime_pm);
+    /* the display pins in the mappable part of the GGTT first, so the aperture covers the buffer */
+    vma = intel_fb_pin_to_ggtt(fb, &view, to_intel_framebuffer(fb)->min_alignment, 0, false, &f->vma_flags);
+    if (IS_ERR(vma)) {
+        ret = PTR_ERR(vma);
+        printf("NullMoth display: i915 could not pin the buffer in the GGTT (%d)\n", ret);
+        goto out_fb;
+    }
+    f->vma = vma;
+    if (!i915_vma_is_map_and_fenceable(vma)) {
+        printf("NullMoth display: the buffer landed outside the GGTT aperture\n");
+        ret = -ENOSPC;
+        goto out_unpin;
+    }
+
+    for_i915_gem_ww(&ww, ret, false) {
+        ret = i915_gem_object_lock(vma->obj, &ww);
+        if (ret)
+            continue;
+        f->vaddr = i915_vma_pin_iomap(vma);
+        if (IS_ERR(f->vaddr)) {
+            ret = PTR_ERR(f->vaddr);
+            f->vaddr = NULL;
+            continue;
+        }
+    }
+    if (ret) {
+        printf("NullMoth display: the buffer would not map through the aperture (%d)\n", ret);
+        goto out_unpin;
+    }
+    intel_runtime_pm_put(&i915->runtime_pm, wakeref);
+
+    out->fb = fb;
+    out->pitch = fb->pitches[0];
+    out->phys = to_gt(i915)->ggtt->gmadr.start + i915_ggtt_offset(vma);
+    out->size = size;
+    out->kva = (void *)f->vaddr;
+    out->priv = f;
+    /* stolen memory holds whatever was there before; shmem pages come zeroed but clearing them costs little */
+    memset_io(f->vaddr, 0, size);
+    printf("NullMoth display: i915 buffer in %s, GGTT 0x%08x, aperture 0x%llx\n", where, i915_ggtt_offset(vma),
+           (unsigned long long)out->phys);
+    return 0;
+
+out_unpin:
+    intel_fb_unpin_vma(vma, f->vma_flags);
+out_fb:
+    intel_runtime_pm_put(&i915->runtime_pm, wakeref);
+    drm_framebuffer_remove(fb);
+    kfree(f);
+    memset(out, 0, sizeof(*out));
+    return ret;
+}
+
+void nmx_i915_fb_destroy(void *priv)
+{
+    struct nmx_i915_fb *f = priv;
+    if (f == NULL)
+        return;
+    if (f->vaddr != NULL)
+        i915_vma_unpin_iomap(f->vma);
+    if (f->vma != NULL)
+        intel_fb_unpin_vma(f->vma, f->vma_flags);
+    drm_framebuffer_remove(f->fb);  /* turns off any plane still scanning it out, then drops it */
+    kfree(f);
+}
diff --git a/gpu-port/xkpi/override/include/nmx_i915_fb.h b/gpu-port/xkpi/override/include/nmx_i915_fb.h
new file mode 100644
index 0000000..7814a5a
--- /dev/null
+++ b/gpu-port/xkpi/override/include/nmx_i915_fb.h
@@ -0,0 +1,24 @@
+/*
+ * The display bridge's scan-out buffer on i915 (override/i915/nmx_i915_fb.c), called from the generic bridge
+ * (override/src/nmx_fb_bridge.c), which is built without i915's headers.
+ */
+#ifndef NMX_I915_FB_H
+#define NMX_I915_FB_H
+
+struct drm_device;
+struct drm_framebuffer;
+
+struct nmx_i915_fb_out {
+    struct drm_framebuffer *fb;     /* XRGB8888, linear */
+    uint32_t pitch;
+    uint64_t phys;                  /* the buffer through the GGTT aperture (BAR2): one contiguous range */
+    uint64_t size;
+    void *kva;                      /* the kernel's write-combined view of that range */
+    void *priv;                     /* for nmx_i915_fb_destroy */
+};
+
+/* a buffer for a width x height mode, pinned and mapped; a negative errno if not */
+int nmx_i915_fb_create(struct drm_device *drm, uint32_t width, uint32_t height, struct nmx_i915_fb_out *out);
+void nmx_i915_fb_destroy(void *priv);
+
+#endif
