From aed59ace459bb5a94f63f10f9ab2917f6a5f012f Mon Sep 17 00:00:00 2001
From: kitsuneislife <kitsuneislif3@gmail.com>
Date: Sat, 14 Nov 2026 00:21:43 -0300
Subject: [PATCH] lat8: -wex-objpreempt sets the global object-preemption
 enable

r145 writes CS_DEBUG_MODE1 (0x20EC) with bit0 clear, and r144 makes
that bit the global object-level preemption enable. The knob writes
bit0=1 instead, leaving CS_CHICKEN1, FF DOP and compute mode alone.
Registry: TGLObjectPreemptionKnob. Test for nmx-intel LAT-8.
---
 WhateverXe/kern_xe.cpp                  | 6 +++++-
 tests/fixtures/boot_argument_names.json | 3 ++-
 2 files changed, 7 insertions(+), 2 deletions(-)

diff --git a/WhateverXe/kern_xe.cpp b/WhateverXe/kern_xe.cpp
index d96a9ab..2a2d6be 100644
--- a/WhateverXe/kern_xe.cpp
+++ b/WhateverXe/kern_xe.cpp
@@ -11463,7 +11463,10 @@ bool XE::processTGLAccelerator(KernelPatcher &patcher, size_t index, mach_vm_add
 			// to r135's10000 before it also feeds2580. Do not alter compute mode.
 			// The replaced MMIO read was overwritten by the following MOV immediate.
 			const uint8_t ffDopFind[] {0x8B,0x90,0xEC,0x20,0,0,0xBA,0,0,1,0,0x89,0x90,0xEC,0x20,0,0};
-			const uint8_t ffDopReplace[] {0xBA,2,0,3,0,0x89,0x90,0xEC,0x20,0,0,0xBA,0,0,1,0,0x90};
+			// nmx LAT-8: -wex-objpreempt writes 20EC bit0=1 here (mask 0x30003), which r144's selector makes the
+			// global object-level preemption enable. Everything else (2580, FF DOP, compute mode) is unchanged.
+			const bool objPreemptKnob=checkKernelArgument("-wex-objpreempt");
+			const uint8_t ffDopReplace[] {0xBA,uint8_t(objPreemptKnob?3:2),0,3,0,0x89,0x90,0xEC,0x20,0,0,0xBA,0,0,1,0,0x90};
 			auto ffDopSite=reinterpret_cast<uint8_t *>(address+0x25166);
 			bool ffDopOK=selectorOK && !memcmp(ffDopSite,ffDopFind,sizeof(ffDopFind));
 			patcher.clearError();
@@ -11490,6 +11493,7 @@ bool XE::processTGLAccelerator(KernelPatcher &patcher, size_t index, mach_vm_add
 			IORegistryEntry::getRegistryRoot()->setProperty("TGLFFDOPClockDisableReady",ffDopOK);
 			IORegistryEntry::getRegistryRoot()->setProperty("TGLObjectPreemptionGlobalReady",selectorOK);
 			IORegistryEntry::getRegistryRoot()->setProperty("TGLObjectPreemptionDisabledReady",objectPreemptOK);
+			IORegistryEntry::getRegistryRoot()->setProperty("TGLObjectPreemptionKnob",objPreemptKnob && ffDopOK);
 			patcher.clearError();
 			// r116: GT2 with 80 EU has ten enabled subslices, but the donor
 			// recognizes only twelve and leaves hwInfo+0x54 (URB banks) zero.
diff --git a/tests/fixtures/boot_argument_names.json b/tests/fixtures/boot_argument_names.json
index f6a6c31..529ec33 100644
--- a/tests/fixtures/boot_argument_names.json
+++ b/tests/fixtures/boot_argument_names.json
@@ -148,5 +148,6 @@
   "-wex-adlp-load-only": [],
   "-wex-display13-offline": [],
   "-wex-dsi-hdmi-test": [],
-  "-wex-dsi-power-test": []
+  "-wex-dsi-power-test": [],
+  "-wex-objpreempt": []
 }
