From cf23f70ea0e1badf0309a0ce2d5211da2aac87f3 Mon Sep 17 00:00:00 2001
From: kitsuneislife <kitsuneislif3@gmail.com>
Date: Sun, 22 Nov 2026 13:40:35 -0300
Subject: [PATCH] xe14b: -wex-noccs lookup window one byte longer than the key

The XE-14 boot recorded WhateverXeNoCCS {1,0}: with the window equal to
the key, Lilu's applyLookupPatch ends its search before the first byte.
This is skmaiti2050 bd5940e, missed in the first port.
---
 WhateverXe/kern_xe.cpp | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/WhateverXe/kern_xe.cpp b/WhateverXe/kern_xe.cpp
index 90f77fa..85911f4 100644
--- a/WhateverXe/kern_xe.cpp
+++ b/WhateverXe/kern_xe.cpp
@@ -11370,7 +11370,7 @@ bool XE::processTGLAccelerator(KernelPatcher &patcher, size_t index, mach_vm_add
    if(base[i]=='E' && !memcmp(base+i,f,sizeof(f))) {rec[0]++;site=base+i;}
   if(rec[0]==1) {
    KernelPatcher::LookupPatch patch {currentGraphics,f,r,sizeof(f),1};
-   patcher.applyLookupPatch(&patch,const_cast<uint8_t *>(site),sizeof(f));
+   patcher.applyLookupPatch(&patch,const_cast<uint8_t *>(site),sizeof(f)+1); // the window must be one byte longer than the key (skmaiti bd5940e)
    rec[1]=patcher.getError()==KernelPatcher::Error::NoError && !memcmp(site,r,sizeof(r));
   }
   patcher.clearError();
-- 
