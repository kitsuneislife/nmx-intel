diff --git a/WhateverXe/kern_host_rps_governor.hpp b/WhateverXe/kern_host_rps_governor.hpp
new file mode 100644
index 0000000..fff670d
--- /dev/null
+++ b/WhateverXe/kern_host_rps_governor.hpp
@@ -0,0 +1,50 @@
+// Host RPS governor for the non-GuC pmNotify frequency query (-disablegfxfirmware).
+// Without GuC, Apple's requested/boost fields stay at RP0 and the native usage
+// values are zero, so answering them pins the GT at its maximum frequency (#176).
+// This policy chooses the frequency from GT busyness instead, measured as the
+// complement of RC6 residency (GEN6_GT_GFX_RC6, 1.28 us ticks). That counter is
+// in the always-accessible mirror range already read by the power sampler, so the
+// hook needs no forcewake, no MMIO writes and no busy-wait sampling.
+// Thresholds follow the up/down evaluation idea of Linux i915 host RPS.
+#pragma once
+#include <stdint.h>
+namespace XeHostRPSGovernor {
+constexpr uint64_t windowNs=16000000ULL;      // minimum evaluation window
+constexpr uint64_t idleGapNs=100000000ULL;    // no callback for this long: idle
+constexpr uint32_t upPercent=70, maxPercent=90, downPercent=30;
+constexpr uint32_t rc6TickNs=1280;
+struct State {
+ uint64_t windowStart {};  // ns; 0 before the first callback
+ uint32_t rc6Start {};
+ uint64_t lastCall {};
+ uint32_t current {};      // 50 MHz units; 0 until initialized
+};
+// Busy percent of the window from RC6 residency ticks (32-bit wrapping counter).
+inline uint32_t busyPercent(uint64_t elapsedNs,uint32_t rc6StartTicks,uint32_t rc6NowTicks) {
+ if(!elapsedNs)return 0;
+ const uint64_t idleNs=uint64_t(uint32_t(rc6NowTicks-rc6StartTicks))*rc6TickNs;
+ if(idleNs>=elapsedNs)return 0;
+ return uint32_t((elapsedNs-idleNs)*100/elapsedNs);
+}
+// Returns the frequency to answer, in 50 MHz units within [lo,hi].
+// lo/hi are RPn/RP0 from RP_STATE_CAP; the caller rejects invalid caps.
+inline uint32_t decide(State &s,uint64_t nowNs,uint32_t rc6Ticks,uint32_t lo,uint32_t hi) {
+ const uint32_t step=(hi-lo+3)/4 ? (hi-lo+3)/4 : 1;
+ if(!s.current || s.current<lo || s.current>hi)s.current=lo;
+ const bool gap=!s.windowStart || nowNs<s.lastCall || nowNs-s.lastCall>idleGapNs;
+ s.lastCall=nowNs;
+ if(gap) {
+  // A long silence means the GT was idle; restart measurement from RPn.
+  s.current=lo;s.windowStart=nowNs;s.rc6Start=rc6Ticks;
+  return s.current;
+ }
+ const uint64_t elapsed=nowNs-s.windowStart;
+ if(elapsed<windowNs)return s.current;
+ const uint32_t busy=busyPercent(elapsed,s.rc6Start,rc6Ticks);
+ if(busy>=maxPercent)s.current=hi;
+ else if(busy>=upPercent)s.current=hi-s.current<step ? hi : s.current+step;
+ else if(busy<downPercent)s.current=s.current-lo<step ? lo : s.current-step;
+ s.windowStart=nowNs;s.rc6Start=rc6Ticks;
+ return s.current;
+}
+}
