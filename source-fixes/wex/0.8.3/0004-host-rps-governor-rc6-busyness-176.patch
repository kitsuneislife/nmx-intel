diff --git a/tests/host_rps_governor.cpp b/tests/host_rps_governor.cpp
new file mode 100644
index 0000000..4bb4e23
--- /dev/null
+++ b/tests/host_rps_governor.cpp
@@ -0,0 +1,62 @@
+// Contract (#176): with -disablegfxfirmware the host pmNotify answer must follow
+// GT busyness instead of Apple's RP0-pinned request fields. Busyness is the
+// complement of RC6 residency (1.28 us ticks, 32-bit wrapping). Retained:
+// answers stay inside [RPn,RP0]; the caller still encodes and clamps them.
+// Not covered here: Lilu routing, MMIO reads, hardware frequency response.
+#include "kern_host_rps_governor.hpp"
+#include <cassert>
+#include <cstdio>
+using namespace XeHostRPSGovernor;
+static constexpr uint32_t lo=2, hi=24; // ADL-P 0x46A8 caps: RPn 100 MHz, RP0 1200 MHz
+static constexpr uint64_t ms=1000000ULL;
+static uint32_t idleTicks(uint64_t ns) { return uint32_t(ns/rc6TickNs); }
+// Advance one window with the given busy percent and return the answer.
+static uint32_t run(State &s,uint64_t &now,uint32_t &rc6,uint32_t busy,uint64_t window=20*ms) {
+ now+=window;rc6+=idleTicks(window*(100-busy)/100);
+ return decide(s,now,rc6,lo,hi);
+}
+int main() {
+ // Busy percent from RC6 ticks, including counter wrap and over-full idle.
+ assert(busyPercent(0,0,0)==0);
+ assert(busyPercent(10*ms,0,idleTicks(10*ms))==0);
+ assert(busyPercent(10*ms,0,0)==100);
+ assert(busyPercent(10*ms,0xFFFFFFF0U,0xFFFFFFF0U+idleTicks(5*ms))==50);
+ assert(busyPercent(10*ms,0,idleTicks(20*ms))==0);
+
+ // First call starts at RPn, never at Apple's RP0 request.
+ State s;uint64_t now=1000*ms;uint32_t rc6=0;
+ assert(decide(s,now,rc6,lo,hi)==lo);
+ // Inside the minimum window the answer does not change.
+ assert(decide(s,now+5*ms,rc6,lo,hi)==lo);
+ now+=5*ms;
+ // Idle desktop (RC6 ~90% as measured on 0x46A8): stays at RPn.
+ for(int i=0;i<50;++i)assert(run(s,now,rc6,10)==lo);
+ // Saturated GT: jumps directly to RP0.
+ assert(run(s,now,rc6,100)==hi);
+ // Moderate load holds; light load steps down gradually to RPn, never below.
+ assert(run(s,now,rc6,50)==hi);
+ uint32_t previous=hi;
+ for(int i=0;i<10;++i) {
+  const uint32_t f=run(s,now,rc6,5);
+  assert(f<=previous && f>=lo);previous=f;
+ }
+ assert(previous==lo);
+ // Sustained 75% busy steps up without overshooting RP0.
+ previous=lo;
+ for(int i=0;i<10;++i) {
+  const uint32_t f=run(s,now,rc6,75);
+  assert(f>=previous && f<=hi);previous=f;
+ }
+ assert(previous==hi);
+ // A long callback gap means idle: restart at RPn.
+ assert(run(s,now,rc6,100,200*ms)==lo);
+ // A clock going backwards is treated as a restart, not as a huge window.
+ assert(decide(s,now-ms,rc6,lo,hi)==lo);
+ // Degenerate single-frequency caps stay valid.
+ State one;assert(decide(one,ms,0,7,7)==7);
+ now=ms;rc6=0;
+ for(int i=0;i<5;++i) { now+=20*ms; assert(decide(one,now,rc6,7,7)==7); }
+ // Out-of-range state is repaired to RPn.
+ State bad;bad.current=200;assert(decide(bad,ms,0,lo,hi)==lo);
+ puts("PASS: RC6 busyness, RPn start, up/down hysteresis, bounds, idle gap, clock reset");
+}
