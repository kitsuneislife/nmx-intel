--- a/intelfb.cpp
+++ b/intelfb.cpp
@@ -422,7 +422,17 @@
     ifb_trail("start");
     bool ok = startReal(provider);
     ifb_trail(ok ? "ok" : "declined");
-    ifb_nv_set("nullmoth-intelfb-attaching", nullptr);
+    // intelfb-0005: RTX-3 froze after start() returned, so the boot guard stays armed until the Mac has lived two
