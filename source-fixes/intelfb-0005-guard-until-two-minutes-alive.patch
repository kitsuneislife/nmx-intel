+    if (ok) {
+        if (thread_call_t alive = thread_call_allocate([](thread_call_param_t, thread_call_param_t) {
+                ifb_trail("alive");
+                ifb_nv_set("nullmoth-intelfb-attaching", nullptr);
+            }, nullptr)) {
+            uint64_t d; clock_interval_to_deadline(120, kSecondScale, &d);
+            thread_call_enter_delayed(alive, d);
+        } else ifb_nv_set("nullmoth-intelfb-attaching", nullptr);
+    } else ifb_nv_set("nullmoth-intelfb-attaching", nullptr);
     return ok;
 }
 
