@@ -150,6 +228,9 @@ static struct i915_vma *take_boot_fb(struct drm_i915_private *i915, u32 base, u3
      * worker after an RCU grace period), so reap them first.
      */
     i915_gem_drain_freed_objects(i915);
+    /* the stolen hold made in init_ggtt gives way to the object that takes the same pages */
+    bool held = drm_mm_node_allocated(&boot_stolen_node);
+    release_boot_stolen(i915);
     obj = i915_gem_object_create_region_at(mem, off, size, I915_BO_ALLOC_USER | I915_BO_PREALLOC);
     if (IS_ERR(obj)) {
         printf("NullMoth display: stolen 0x%llx+0x%x is taken (%ld)\n", (unsigned long long)off, size,
@@ -159,6 +240,9 @@ static struct i915_vma *take_boot_fb(struct drm_i915_private *i915, u32 base, u3
             snprintf(step, sizeof(step), "tk-obj%ld@%llx+%x", PTR_ERR(obj), (unsigned long long)off, size);
             nmx_xnu_trail(step);
         }
+        trail_stolen_owners(i915, off, size);
+        if (held && hold_boot_stolen(i915, off, size))
+            nmx_xnu_trail("shold-lost");
         return NULL;
     }
