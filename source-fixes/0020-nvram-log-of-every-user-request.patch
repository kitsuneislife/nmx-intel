+/*
+ * "nullmoth-gpu-io": what user space asks of the GPU, written to NVRAM as it happens, so a boot that freezes shows
+ * the request in flight. Tokens: "o<pid>" an open, "c" a close, "<g><nr>" an ioctl starting (g is the ioctl group
+ * letter: d = DRM, N = the port's mmap), "+" one that returned 0, "-<errno>" one that failed. The newest 470
+ * characters are kept; writing stops after 400 tokens (the start is what matters).
+ */
+static IOLock *gIoLock;
+static char gIo[480];
+static unsigned gIoWrites;
+
+extern "C" void nmx_xnu_iolog(const char *tok)
+{
+    if (gIoLock == nullptr || tok == nullptr)
+        return;
+    IOLockLock(gIoLock);
+    if (gIoWrites >= 400) {
+        IOLockUnlock(gIoLock);
+        return;
+    }
+    gIoWrites++;
+    size_t len = strlen(gIo), add = strlen(tok);
+    while (len + add + 2 > sizeof(gIo) - 10) {       /* drop the oldest token */
+        char *sp = strchr(gIo, ' ');
+        if (sp == nullptr) { gIo[0] = 0; len = 0; break; }
+        memmove(gIo, sp + 1, strlen(sp + 1) + 1);
+        len = strlen(gIo);
+    }
+    if (len)
+        gIo[len++] = ' ';
+    memcpy(gIo + len, tok, add + 1);
+    IODTNVRAM *n = nmx_nvram();
+    if (n != nullptr) {
+        const OSSymbol *k = OSSymbol::withCString("nullmoth-gpu-io");
+        OSData *d = OSData::withBytes(gIo, (unsigned)strlen(gIo));
+        if (k != nullptr && d != nullptr)
+            n->setProperty(k, d);
+        if (d)
+            d->release();
+        if (k)
+            k->release();
+        n->sync();
+        n->release();
+    }
+    IOLockUnlock(gIoLock);
+}
