+/*
+ * After the attach: every 2 s for 5 min, "nullmoth-gpu-beat" = seconds since the outputs were published, plus what
+ * user space has asked of the GPU (opens, ioctls, ioctls in flight, last command). A boot that freezes leaves the
+ * last beat in NVRAM, so the next boot shows how long the Mac lived and whether Metal was in the GPU at the time.
+ */
+static const char *const kBeat = "nullmoth-gpu-beat";
+
+static void nmx_beat_write(const char *s)
+{
+    IODTNVRAM *n = nmx_nvram();
+    if (n == nullptr)
+        return;
+    const OSSymbol *k = OSSymbol::withCString(kBeat);
+    if (k != nullptr) {
+        if (s != nullptr) {
+            OSData *d = OSData::withBytes(s, (unsigned)strlen(s));
+            if (d != nullptr) {
+                n->setProperty(k, d);
+                d->release();
+            }
+        } else {
+            n->removeProperty(k);
+        }
+        k->release();
+    }
+    n->sync();
+    n->release();
+}
+
+static void nmx_beat_thread(void *, wait_result_t)
+{
+    char s[96];
+    for (int t = 2; t <= 300; t += 2) {
+        IOSleep(2000);
+        int opens, ioctls, inside;
+        uint32_t cmd;
+        nmx_xnu_node_stats(&opens, &ioctls, &inside, &cmd);
+        snprintf(s, sizeof(s), "t=%d open=%d ioctl=%d in=%d cmd=0x%x", t, opens, ioctls, inside, cmd);
+        nmx_beat_write(s);
+    }
+    thread_terminate(current_thread());
+}
