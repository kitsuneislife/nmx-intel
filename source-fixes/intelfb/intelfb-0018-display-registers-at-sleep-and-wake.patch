+    if (fb && !gIfbRamFB) { gIfbRamFB = fb; sysctl_register_oid(&sysctl__debug_nmintelfb_ram); sysctl_register_oid(&sysctl__debug_nmintelfb_regs); }
+    else if (!fb && gIfbRamFB) { sysctl_unregister_oid(&sysctl__debug_nmintelfb_ram); sysctl_unregister_oid(&sysctl__debug_nmintelfb_regs); gIfbRamFB = nullptr; }
 }
 
