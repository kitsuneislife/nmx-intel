+// intelfb-0017. GGTT entries live behind the register BAR at half its size (8 MiB here, i915 gen6_gttadr_offset), one
+// 64-bit PTE per 4 KiB: phys | present (gen8_ggtt_pte_encode). Display 11+ maps them uncached, as our BAR0 map is;
+// GFX_FLSH_CNTL_GEN6 (0x101008) = 1 flushes the GGTT TLBs as the GuC path does.
+void NMIntelFB::ramPtes(bool ours)
+{
+    volatile uint64_t *g = (volatile uint64_t *)(fRegs + 0x800000) + (fSurf >> 12);
+    for (unsigned i = 0; i < fRamCount; i++) g[i] = ours ? (fRamPages[i] | 1ull) : fOldPte[i];
+    *(volatile uint32_t *)(fRegs + 0x101008) = 1;
+    (void)g[fRamCount - 1];   // posts the writes
+}
+
+// 1 on, 0 off; < 0 why it would not turn on (nothing changed then)
+int NMIntelFB::ramSet(bool on)
+{
+    if (on == fRamOn) return on;
+    if (!on) { fRamOn = false; ramPtes(false); IFBLOG("ram scanout off: GGTT back to the firmware's pages"); ifb_trail("ram-off"); return 0; }
+    if (!fRegs || !fSurfMap || fVer < 12) return -1;
+    const unsigned long long len = (unsigned long long)fRowBytes * fHeight;
+    const unsigned n = (unsigned)((len + 4095) >> 12);
+    if (fMMIO->getLength() < 0x800000ull + ((fSurf >> 12) + (unsigned long long)n) * 8) return -2;
+    if (!fRam) {
+        // physically contiguous when it can be, so the copy engine makes one run
+        const IOOptionBits o = kIODirectionInOut;
+        IOBufferMemoryDescriptor *b = IOBufferMemoryDescriptor::inTaskWithPhysicalMask(kernel_task, o | kIOMemoryPhysicallyContiguous, (vm_size_t)n * 4096, 0x7FFFFFF000ull);
+        if (!b) b = IOBufferMemoryDescriptor::inTaskWithPhysicalMask(kernel_task, o, (vm_size_t)n * 4096, 0x7FFFFFF000ull);
+        if (!b) return -3;
+        if (b->prepare() != kIOReturnSuccess) { b->release(); return -3; }
+        unsigned long long *pg = IONew(unsigned long long, n), *old = IONew(unsigned long long, n);
+        bool ok = pg && old;
+        for (unsigned i = 0; ok && i < n; i++) {
+            IOByteCount sl = 0;
+            pg[i] = b->getPhysicalSegment((IOByteCount)i * 4096, &sl, kIOMemoryMapperNone);
+            ok = pg[i] && !(pg[i] & 0xFFF);
+        }
+        if (!ok) { if (pg) IODelete(pg, unsigned long long, n); if (old) IODelete(old, unsigned long long, n); b->complete(); b->release(); return -4; }
+        unsigned runs = 1; for (unsigned i = 1; i < n; i++) if (pg[i] != pg[i - 1] + 4096) runs++;
+        fRam = b; fRamPages = pg; fOldPte = old; fRamCount = n;
+        IFBLOG("ram scanout: %u pages at 0x%llx in %u run(s)", n, pg[0], runs);
+    }
+    volatile uint64_t *g = (volatile uint64_t *)(fRegs + 0x800000) + (fSurf >> 12);
+    for (unsigned i = 0; i < fRamCount; i++) fOldPte[i] = g[i];
+    // the picture on the panel first, so the switch shows no black frame (reads the aperture: slow, once)
+    memcpy(fRam->getBytesNoCopy(), (const void *)fSurfMap->getVirtualAddress(), (size_t)len);
+    // the display does not snoop CPU caches: push the copy out to RAM (the copy engine's writes reach RAM themselves)
+    for (size_t o = 0; o < len; o += 64) __asm__ volatile("clflush %0" : : "m"(((volatile const char *)fRam->getBytesNoCopy())[o]));
+    __asm__ volatile("mfence" ::: "memory");
+    ramPtes(true);
+    for (unsigned i = 0; i < fRamCount; i++) if (g[i] != (fRamPages[i] | 1ull)) {
+        ramPtes(false);
+        IFBLOG("ram scanout: GGTT entry %u read back 0x%llx, not 0x%llx - firmware pages restored", i, (unsigned long long)g[i], fRamPages[i] | 1ull);
+        return -5;
+    }
+    fRamOn = true;
+    IFBLOG("ram scanout on: GGTT 0x%x..0x%x now RAM (firmware PTE[0] was 0x%llx)", fSurf, fSurf + fRamCount * 4096, fOldPte[0]);
+    ifb_trail("ram-on");
+    return 1;
+}
+
+static int gIfbRamState;
+static volatile SInt32 gIfbRamBusy;
+static int ifb_ram_sysctl SYSCTL_HANDLER_ARGS
+{
+    int v = gIfbRamState, err = sysctl_handle_int(oidp, &v, 0, req);
+    if (err || !req->newptr) return err;
+    if (v != 0 && v != 1) return EINVAL;
+    NMIntelFB *fb = gIfbRamFB;
+    if (!fb) return ENXIO;
+    if (!OSCompareAndSwap(0, 1, &gIfbRamBusy)) return EBUSY;
+    gIfbRamState = fb->ramSet(v == 1);
+    gIfbRamBusy = 0;
+    return gIfbRamState < 0 ? EIO : 0;
+}
+SYSCTL_PROC(_debug, OID_AUTO, nmintelfb_ram, CTLTYPE_INT | CTLFLAG_RW | CTLFLAG_LOCKED | CTLFLAG_KERN, nullptr, 0,
+            ifb_ram_sysctl, "I", "1 = the panel scans out of RAM that NVAccel's copy engine writes (0 off, < 0 failed)");
+static void ifb_ram_register(NMIntelFB *fb)
+{
+    if (fb && !gIfbRamFB) { gIfbRamFB = fb; sysctl_register_oid(&sysctl__debug_nmintelfb_ram); }
+    else if (!fb && gIfbRamFB) { sysctl_unregister_oid(&sysctl__debug_nmintelfb_ram); gIfbRamFB = nullptr; }
+}
