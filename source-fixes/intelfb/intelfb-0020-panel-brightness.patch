+    static constexpr uint32_t kBlcCtl = 0xC8250, kBlcFreq = 0xC8254, kBlcDuty = 0xC8258;
+    int backlightPercent() {
+        const uint32_t f = rd(kBlcFreq), d = rd(kBlcDuty);
