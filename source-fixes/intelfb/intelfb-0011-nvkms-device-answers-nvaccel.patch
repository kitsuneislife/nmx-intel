+        if (!r || r->version != NVRM_VRAM_ABI_VERSION) return kIOReturnBadArgument;
+        return alloc ? vramGrant(r) : vramRelease(r);
     }
     return IOFramebuffer::callPlatformFunction(fn, wait, p1, p2, p3, p4);
 }
