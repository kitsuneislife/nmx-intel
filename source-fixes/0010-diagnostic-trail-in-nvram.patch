 static const char *const kAttachMarker = "nullmoth-gpu-attaching";
 
+/*
+ * Diagnostic trail: each step of the bring-up is appended to an NVRAM variable and synced at once, so a freeze that
+ * takes the unflushed log with it (tests 6 and 9 left no line at all) still shows how far the Mac got. Bounded, so
+ * a long session cannot keep writing NVRAM.
+ */
+static const char *const kTrail = "nullmoth-gpu-trail";
+static IOLock *gTrailLock;
+static char gTrail[240];
+static unsigned gTrailWrites;
+
 static IODTNVRAM *nmx_nvram()
 {
     IORegistryEntry *e = IORegistryEntry::fromPath("/options", gIODTPlane);
@@ -183,6 +193,39 @@ static void nmx_marker_write(bool on)
     n->release();
 }
 
+static IODTNVRAM *nmx_nvram();
+
+extern "C" void nmx_xnu_trail(const char *step)
+{
+    if (gTrailLock == nullptr || step == nullptr)
+        return;
+    IOLog("NullMoth trail: %s\n", step);
+    IOLockLock(gTrailLock);
+    size_t len = strlen(gTrail), add = strlen(step);
+    if (gTrailWrites >= 40 || len + add + 2 > sizeof(gTrail)) {
+        IOLockUnlock(gTrailLock);
+        return;
+    }
+    if (len)
+        gTrail[len++] = ' ';
+    memcpy(gTrail + len, step, add + 1);
+    gTrailWrites++;
+    IODTNVRAM *n = nmx_nvram();
+    if (n != nullptr) {
+        const OSSymbol *k = OSSymbol::withCString(kTrail);
+        OSData *d = OSData::withBytes(gTrail, (unsigned)strlen(gTrail));
+        if (k != nullptr && d != nullptr)
+            n->setProperty(k, d);
+        if (d)
+            d->release();
+        if (k)
+            k->release();
+        n->sync();
+        n->release();
+    }
+    IOLockUnlock(gTrailLock);
+}
